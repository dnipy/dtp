{
  "name": "dtp",
  "version": "1.0.0",
  "description": "A simple custom TCP application protocol",
  "scripts": {
    "server": "tsx src/server/server.ts",
    "dtp": "tsx scripts/dtp-cli.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server/server.js",
    "test": "tsx --test tests/**/*.test.ts",
    "test:watch": "tsx --test --watch tests/**/*.test.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.0.0",
    "typescript": "^5.0.0"
  }
}
